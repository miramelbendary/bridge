# Copy to backend/.env for local development. Never commit a real .env file.

ENVIRONMENT=development

# PostgreSQL (see infrastructure/docker-compose.yml). SQLite works for quick local tests only:
#   DATABASE_URL=sqlite:///./bridge_dev.db
DATABASE_URL=postgresql+psycopg://bridge:bridge@localhost:5432/bridge

# Authentication provider: "local" (BRIDGE-issued JWTs) or "supabase".
AUTH_PROVIDER=local
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
LOCAL_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Only when AUTH_PROVIDER=supabase. Newer projects (asymmetric keys) need SUPABASE_URL only;
# legacy HS256 projects also need SUPABASE_JWT_SECRET (Project Settings -> API -> JWT secret).
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
