# Used by infrastructure/docker-compose.yml. Copy to .env at the repository root.
# Service-specific templates: backend/.env.example and frontend/.env.example.

POSTGRES_USER=bridge
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=bridge

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
LOCAL_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:3000
