# Used by docker-compose.yml at the repository root. Copy to .env and edit.
# (For running without Docker, start.ps1 / start.sh create backend/.env for you.)

POSTGRES_USER=bridge
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=bridge

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
LOCAL_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# "mock" = offline, free, deterministic. "anthropic" = Claude API (needs a key).
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# Show demo logins on the sign-in page (local demos only).
BRIDGE_DEMO_MODE=1
ENVIRONMENT=development
